# ============================================================================
# Local settings — copy this file to .env and fill in what you need.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / macOS:    cp .env.example .env
#
# .env is gitignored and read at startup by `npm run dev` and `npm start`
# (node --env-file-if-exists=.env). Every line below is optional: with no .env
# at all the app runs on Ollama exactly as it always has.
#
# Changes take effect on the NEXT SERVER START. Stop the server and start it
# again after editing this file.
# ============================================================================

# --- Which model answers by default ---------------------------------------
# ollama | gemini. This is only the starting position of the switch in the
# sidebar; whoever is using the app can move it per run, and the browser
# remembers where they left it.
# AI_PROVIDER=ollama

# --- Google Gemini (the cloud option) --------------------------------------
# Without a key the Gemini entry in the switch is visible but greyed out.
# Get a key at https://aistudio.google.com/apikey — sign in, click "Get API
# key", then "Create API key", and copy the string it shows you.
#
# Replace the placeholder with the key itself — no quotes, no spaces around
# the "=". Left as it is, the placeholder counts as no key at all.
#
# Note what choosing Gemini means: the transcript leaves this machine and is
# sent to Google, and each run costs money. The Ollama option does neither.
GEMINI_API_KEY=your-gemini-api-key-here

# The model the switch starts on. Extraction is one call per chunk, so the
# per-call price is what a long document multiplies — hence a "lite" default.
# GEMINI_MODEL=gemini-3.1-flash-lite

# What the Model dropdown offers, cheapest first. Comma-separated. A model
# released after this was written becomes selectable by adding it here, with no
# code change — and the server refuses any id that is not on this list, so a
# typo cannot reach the API and bill you for something unexpected.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash-lite

# Tried in order, one after the other, when the chosen model answers "busy"
# (HTTP 503 or 429). A run is one call per chunk, so without this a single busy
# minute halfway through a book would cost every chunk after it.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# GEMINI_TIMEOUT_MS=120000
# GEMINI_RETRIES=1
# GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Ollama (the local option) ---------------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_TIMEOUT_MS=120000

# --- Everything else -------------------------------------------------------
# The full list of settings, with the reasoning for each default, is in
# lib/config.js.
# PORT=3200
# TRANSCRIPT_CHUNK_SIZE=3500
# GRAPH_STORE_DIR=./data/graphs
